{
  "name": "017 · 中世纪现代 Mid-Century Modern",
  "rule": "每一块都是一张剪出来、能拿起来的纸：影子 = 高度",
  "color": {
    "paper": "#FBF3E3",
    "red": "#F2542D",
    "sun": "#FFC62E",
    "pink": "#F57AA8",
    "turq": "#1FB3A6",
    "blue": "#2F6BD8",
    "ink": "#1E1B19",
    "mute": "#8A7F72",
    "shadow": "#3A1C0C"
  },
  "area": {
    "paper": 0.4,
    "red": 0.14,
    "sun": 0.14,
    "pink": 0.12,
    "turq": 0.1,
    "blue": 0.06,
    "ink": 0.04
  },
  "overprint": {
    "sun×pink": "#F55F1E",
    "sun×turq": "#1F8B1E",
    "pink×turq": "#1E566D",
    "rule": "浅色压深色，multiply"
  },
  "cut": {
    "wobble_px": [
      1.0,
      1.6
    ],
    "wavelength_px": [
      50,
      110
    ],
    "tilt_deg": 3,
    "corners": "保留尖角"
  },
  "shadow": {
    "offset": "(0.5h, h)",
    "blur_svg_stddev": "0.4h",
    "blur_css": "0.8h",
    "opacity": "0.3 - 0.004h",
    "scale": "1 + 0.0032h",
    "rest_h": 4,
    "lifted_h": 14,
    "held_h": 30,
    "pressed_h": 0
  },
  "motion": {
    "fps": 60,
    "bpm": 144,
    "beat_frames": 25,
    "move": "cubic-bezier(.65,0,.35,1) 670ms",
    "land_slap": 0.04,
    "sheet_slide_frames": 18,
    "durationFrames": 900,
    "size": [
      1920,
      1080
    ]
  },
  "font": {
    "display": "Anton（转轮廓后手剪）",
    "text": "Jost（Futura 的开源替代）",
    "sc": "Noto Sans SC Black"
  }
}
