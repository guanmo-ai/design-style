{
  "name": "021 · 生成艺术 Generative Art",
  "rule": "从一个点长出来",
  "color": {
    "background": "#F3EEE2",
    "ink": "#161616",
    "orange": "#FF6A1A",
    "pink": "#FF2D8A",
    "blue": "#2346E0",
    "gold": "#FFC530"
  },
  "font": {
    "mono": "JetBrains Mono",
    "sc": "Noto Sans SC",
    "display": "Archivo"
  },
  "motion": {
    "fps": 60,
    "bpm": 120,
    "beat_frames": 30,
    "durationFrames": 1080,
    "size": [
      1920,
      1080
    ],
    "renderer": "Canvas 2D",
    "signature": "grow-from-point"
  },
  "flow": {
    "step": 4,
    "gap": 5,
    "occupancyCell": 4,
    "ribbonWidths": [
      6,
      10,
      16,
      26,
      40,
      64,
      96
    ]
  }
}
