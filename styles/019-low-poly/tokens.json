{
  "name": "019 · 低多边形 Low Poly",
  "years": "1993 星际火狐 → 2010 年代独立游戏与插画 → 今天的图标、空状态与 3D 插画",
  "idea": "一个面，一个颜色：世界由平涂的三角面组成，光一转，面就在三档明暗之间跳",
  "color": {
    "paper":  {"hex": "#FBF4E6", "use": "纸、三角面的背面"},
    "bg":     {"hex": "#F6EEDD", "use": "底色"},
    "red":    {"hex": "#EE6B57", "use": "火车、灯塔条纹、强调"},
    "yellow": {"hex": "#F4C54F", "use": "田、树冠、按钮"},
    "green":  {"hex": "#4DAF72", "use": "山、松树"},
    "lgreen": {"hex": "#9ED7A8", "use": "草地、亮面"},
    "sky":    {"hex": "#8CC8EE", "use": "湖、天"},
    "sea":    {"hex": "#7DB8E8", "use": "海"},
    "pink":   {"hex": "#F49DB6", "use": "田垄、花"},
    "lilac":  {"hex": "#C9A6EC", "use": "远山"},
    "peri":   {"hex": "#8F9DEA", "use": "山顶、阴面"},
    "blue":   {"hex": "#2F5FD8", "use": "点缀"},
    "ink":    {"hex": "#3B3552", "use": "文字、火车头"},
    "shade":  {"hex": "#7A5C86", "use": "暗面往暖紫里混，不发灰"}
  },
  "shading": {"bands": [0.26, 0.1, 0.0], "note": "三档：暗面往 shade 混 26%，中间 10%，亮面原色；夜里三档一起往 #2E2A58 压"},
  "polygonBudget": [1280, 320, 80],
  "font": {"cn": "Noto Sans SC Black / Bold", "latin": "Inter 800"},
  "physics": {
    "unfold": {"dur": 0.5, "note": "三角面以一条边为铰链翻 180°：背面是纸，翻过来是颜色，落到最终高度过冲约 5%"},
    "slam": {"note": "第 2 章反过来：带着颜色从天上砸下来，由远到近一排排落"},
