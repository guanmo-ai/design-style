      "hex": "#F7C9D3",
      "use": "二层外墙"
    },
    "lilac": {
      "hex": "#CDB9F0",
      "use": "民居、房间墙"
    },
    "sky": {
      "hex": "#7DB8E8",
      "use": "水、售货机"
    },
    "butter": {
      "hex": "#F5C451",
      "use": "银杏、椅子、点缀"
    },
    "coral": {
      "hex": "#F27D6A",
      "use": "售货机、杯子"
    },
    "ink": {
      "hex": "#3B3552",
