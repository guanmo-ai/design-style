    "stagger": {"tile": 0.022, "layer": 0.14, "unit": "秒"}
  },
  "motion": {"fps": 30, "bpm": 120, "beatSec": 0.5, "durationSec": 20, "durationFrames": 600, "size": [1920, 1080]},
  "video": {"width": 1920, "height": 1080, "fps": 30, "frames": 600}
