{
  "name": "018 · 微缩景观 Diorama",
  "years": "1950s 模型铁路 → 2001 Miniatur Wunderland → 2014 等距游戏 → 今天",
  "idea": "把世界切成一块底座，一块块搭出来，再用移轴把它变小",
  "color": {
    "paper":  {"hex": "#F6EEDD", "use": "底色、纸屑边"},
    "cream":  {"hex": "#FFF7EC", "use": "木框、白墙"},
    "soil":   {"hex": "#C99A72", "use": "土层（由深到浅 #C99A72 #DDB48A #EED0A6）"},
    "mint":   {"hex": "#7FCBA8", "use": "店面、草地"},
    "pink":   {"hex": "#F28AA6", "use": "遮阳篷、地毯、按钮"},
    "peach":  {"hex": "#F7C9D3", "use": "二层外墙"},
    "lilac":  {"hex": "#CDB9F0", "use": "民居、房间墙"},
    "sky":    {"hex": "#7DB8E8", "use": "水、售货机"},
    "butter": {"hex": "#F5C451", "use": "银杏、椅子、点缀"},
    "coral":  {"hex": "#F27D6A", "use": "售货机、杯子"},
    "ink":    {"hex": "#3B3552", "use": "文字、电线、手机边框"},
    "shade":  {"hex": "#7A5C86", "use": "阴影往暖紫里混，不发灰"}
  },
  "night": {"sky": ["#C3A6E6", "#F0BCD2", "#FFD3B4"], "lamp": "#FFC77A"},
  "font": {"cn": "Noto Sans SC Black / Bold", "latin": "Inter 800"},
  "camera": {"fov": 20, "pitchDeg": 30, "yawDeg": 42, "note": "长焦 + 俯视，近大远小几乎消失，像在桌上看模型"},
  "tiltShift": {"focus": 0.56, "band": 0.26, "blurAmount": 2.0, "note": "画面高度的 26% 清楚，上下按距离线性变虚"},
  "physics": {
    "slam": {"fall": "前 60% 自由落体", "squash": 0.16, "note": "落地压扁 16% 再回弹，以底面为原点"},
