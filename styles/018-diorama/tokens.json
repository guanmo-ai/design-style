      "use": "阴影往暖紫里混，不发灰"
    }
  },
  "night": {
    "sky": [
      "#C3A6E6",
      "#F0BCD2",
      "#FFD3B4"
    ],
    "lamp": "#FFC77A"
  },
  "font": {
    "cn": "Noto Sans SC Black / Bold",
    "latin": "Inter 800"
  },
  "camera": {
    "fov": 20,
    "pitchDeg": 30,
    "yawDeg": 42,
    "note": "长焦 + 俯视，近大远小几乎消失；第三版镜头走单调三次样条，经过关键帧时速度连续，不再一停一顿"
  },
  "tiltShift": {
    "focus": 0.56,
    "band": 0.26,
    "blurAmount": 2.0,
    "note": "画面高度的 26% 清楚，上下按距离线性变虚"
  },
  "physics": {
    "slam": {
      "fall": "前 60% 自由落体（下落时拉长 12%）",
      "squash": 0.16,
      "note": "落地压扁 16%，再像软胶一样衰减地抖 1.5 下停住（衰减正弦，速度连续），以底面为原点"
    },
    "overshoot": 0.05,
    "stagger": {
      "tile": 0.022,
      "layer": 0.14,
      "unit": "秒"
    },
    "spring": {
      "overshoot": 0.05,
      "note": "升起 / 弹出 / 推进都用欠阻尼弹簧（ω=5—7，ζ≈0.75），过冲约 5%，竖向拉长时横向收一点（体积守恒）"
    }
  },
  "motion": {
    "fps": 60,
    "bpm": 120,
    "beatSec": 0.5,
    "durationSec": 20,
    "durationFrames": 1200,
    "size": [
      1920,
      1080
    ]
  },
  "video": {
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "frames": 1200
  },
  "shape": {
    "corner": "所有方块都是圆角（半径取短边的 28%，最大 0.14），平滑着色",
    "foliage": "树冠、灌木、云是一团团软球拼起来的",
    "note": "3D 动画电影的道具感：边是软的、东西是圆的、比例头大身小"
  },
  "light": {
    "key": "低角度暖色主光 #FFE6C4（金色时刻，影子长）",
    "fill": "冷色天光 #DDE8FF，暗部往 #7A5C86 暖紫里混",
    "rim": "背后粉色轮廓光 #FFD6EC 勾边",
    "env": "摄影棚环境贴图 0.3，给漆面一点高光",
    "grade": "饱和度 1.12、对比 1.08、暗角 0.28"
  },
  "audio": {
    "key": "F 大调",
    "bpm": 120,
    "loudness": "-15 LUFS",
    "note": "一条不断线的配乐：竖琴八分音符分解和弦铺底、弦乐按声部连写、一个旋律动机从钢琴传到小提琴再到钢片琴；零件音效全部调进当前和弦，同类 90 毫秒内只响一次"
  }
}
