{
  "name": "03-scrollytelling",
  "type": "layout",
  "title": "滚动叙事 Scrollytelling",
  "years": "2012—",
  "color": {
    "night": "#000000",
    "panel": "#1C1C1E",
    "panel2": "#2C2C2E",
    "text": "#F5F5F7",
    "textSecondary": "#86868B",
    "paper": "#F5F5F7",
    "ink": "#1D1D1F",
    "inkSecondary": "#6E6E73",
    "accent": "#2997FF",
    "trigger": "#FF5C9A",
    "stuck": "#30D158",
    "gradient": ["#FF7A2F", "#FF2E7E", "#8B3DFF", "#2997FF"]
  },
  "scroll": {
    "section": "tall, ≈ (steps + 1) × 100vh",
    "stage": {"position": "sticky", "top": 0, "height": "100vh"},
    "stepGap": "100vh",
    "trigger": 0.5,
    "state": "stage = f(scrollY)",
    "patterns": ["side-by-side", "overlay", "scrub", "horizontal"],
    "sideBySide": {"stage": "7fr", "steps": "5fr"},
    "breakpoint": {"overlayBelow": 768},
    "reducedMotion": "jump to each step's end state"
  },
  "font": {
    "display": "Inter Display 600 / 700",
    "text": "Inter 400 / 500",
    "cjk": "Noto Sans SC 400 / 500 / 700",
    "serif": "Instrument Serif 400 (Snow Fall chapter)",
    "mono": "Geist Mono 400 / 500"
  },
  "motion": {
    "fps": 60,
    "bpm": 120,
    "beatFrames": 30,
    "size": [1920, 1080],
    "durationFrames": 900,
    "virtualPage": {"height": 21060, "flicks": 30}
  }
}
